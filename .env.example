# API key de Google Gemini para sugerir criterios de aceptación (solo servidor).
# En local, cópiala a .env.local (ignorado por git), NO a .env, que sí está versionado.
GOOGLE_GENERATIVE_AI_API_KEY=

# URL "Production" del nodo Webhook de n8n que notifica cambios de estado de HU por Telegram.
# Si queda vacía, la app funciona igual pero no envía notificaciones.
N8N_WEBHOOK_URL=
